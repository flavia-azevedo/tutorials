from sentence_transformers import SentenceTransformer, util
from transformers import pipeline, AutoModelForCausalLM, AutoTokenizer
import numpy as np
import torch

class RAGEvaluator:
    def __init__(self):
        self.model = SentenceTransformer('all-MiniLM-L6-v2')  # For text similarity
        self.summarizer = pipeline("summarization", model="facebook/bart-large-cnn")
        self.llm_model = "meta-llama/Llama-2-7b-chat-hf"  # Change as needed
        self.tokenizer = AutoTokenizer.from_pretrained(self.llm_model)
        self.llm = AutoModelForCausalLM.from_pretrained(self.llm_model, device_map="auto", torch_dtype=torch.float16)

    def evaluate_relevance(self, query, retrieved_chunks):
        """Check if retrieved chunks are relevant to the query."""
        query_embedding = self.model.encode(query, convert_to_tensor=True)
        chunk_embeddings = self.model.encode(retrieved_chunks, convert_to_tensor=True)
        scores = util.pytorch_cos_sim(query_embedding, chunk_embeddings)[0].tolist()
        avg_score = np.mean(scores)  # Higher = more relevant
        return avg_score

    def evaluate_faithfulness(self, generated_response, retrieved_chunks):
        """Check if generated response is grounded in retrieved chunks."""
        chunk_text = " ".join(retrieved_chunks)
        gen_embedding = self.model.encode(generated_response, convert_to_tensor=True)
        chunk_embedding = self.model.encode(chunk_text, convert_to_tensor=True)
        score = util.pytorch_cos_sim(gen_embedding, chunk_embedding).item()  # High score = faithful
        return score

    def evaluate_completeness(self, query, generated_response):
        """Check if key entities from query appear in response."""
        query_tokens = set(query.lower().split())
        response_tokens = set(generated_response.lower().split())
        common_tokens = query_tokens.intersection(response_tokens)
        completeness_score = len(common_tokens) / len(query_tokens)
        return completeness_score

    def evaluate_fluency(self, generated_response):
        """Check if response is clear and concise using a summarizer."""
        summary = self.summarizer(generated_response, max_length=50, min_length=20, do_sample=False)
        summary_text = summary[0]['summary_text']
        fluency_score = len(summary_text) / len(generated_response)  # Lower ratio = more concise
        return fluency_score

    def evaluate(self, query, retrieved_chunks, generated_response):
        """Evaluate the RAG pipeline using multiple metrics."""
        relevance_score = self.evaluate_relevance(query, retrieved_chunks)
        faithfulness_score = self.evaluate_faithfulness(generated_response, retrieved_chunks)
        completeness_score = self.evaluate_completeness(query, generated_response)
        fluency_score = self.evaluate_fluency(generated_response)

        return {
            "Relevance Score": round(relevance_score, 3),
            "Faithfulness Score": round(faithfulness_score, 3),
            "Completeness Score": round(completeness_score, 3),
            "Fluency Score": round(fluency_score, 3),
        }

    def final_evaluator(self, query, retrieved_chunks, generated_response):
        """Pass all evaluation scores and context to an LLM for final judgment."""
        scores = self.evaluate(query, retrieved_chunks, generated_response)
        
        prompt = f"""
        You are an AI evaluator assessing the quality of a Retrieval-Augmented Generation (RAG) system.
        Here are the details:

        - **User Query:** {query}
        - **Retrieved Chunks:** {retrieved_chunks}
        - **Generated Response:** {generated_response}

        - **Evaluation Scores:**
          - Relevance Score: {scores["Relevance Score"]}
          - Faithfulness Score: {scores["Faithfulness Score"]}
          - Completeness Score: {scores["Completeness Score"]}
          - Fluency Score: {scores["Fluency Score"]}

        Provide a final judgment:
        1. Is the generated response **accurate and reliable**?
        2. Are there any **hallucinations** or missing information?
        3. How can the retrieval or generation be improved?
        4. Assign an **overall rating (0-10)** and explain why.
        """
        
        input_ids = self.tokenizer(prompt, return_tensors="pt", truncation=True).input_ids.to("cuda")
        output = self.llm.generate(input_ids, max_length=512, temperature=0.5)
        final_judgment = self.tokenizer.decode(output[0], skip_special_tokens=True)

        return {
            "Evaluation Scores": scores,
            "Final LLM Judgment": final_judgment
        }

# Example Usage
if __name__ == "__main__":
    evaluator = RAGEvaluator()
    query = "What was the net income for 2023?"
    retrieved_chunks = ["The company's net income for 2023 was $1.2 billion.", "Revenue increased by 5%."]
    generated_response = "The net income for 2023 was $1.2 billion."

    result = evaluator.final_evaluator(query, retrieved_chunks, generated_response)
    print(result)


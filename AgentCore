import boto3, json, uuid

agent_runtime_arn = "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/my-agent"
session_id = str(uuid.uuid4())  # keep to maintain conversation context

client = boto3.client("bedrock-agentcore", region_name="us-east-1")

payload = json.dumps({"prompt": "Write a haiku about servers"}).encode()

resp = client.invoke_agent_runtime(
    agentRuntimeArn=agent_runtime_arn,
    runtimeSessionId=session_id,   # like sessionId, but for AgentCore Runtime
    payload=payload
)

# Streaming responses use text/event-stream. Fallback to JSON.
if "text/event-stream" in resp.get("contentType", ""):
    for line in resp["response"].iter_lines(chunk_size=10):
        if line:
            line = line.decode("utf-8")
            if line.startswith("data: "):
                print(line[6:])
else:
    chunks = resp.get("response", [])
    print(b"".join(chunks).decode("utf-8"))

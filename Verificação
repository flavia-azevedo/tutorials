from langdetect import detect
import unicodedata

def verificar_mensagem(pergunta: str, resposta: str, min_len=5, max_len=5000):
    def validar_texto(texto):
        # Verifica se o texto está codificado em UTF-8
        try:
            texto.encode('utf-8')
        except UnicodeEncodeError:
            return False, "Texto com codificação inválida (não UTF-8)."

        # Verifica o idioma
        try:
            idioma = detect(texto)
            if idioma not in ['pt', 'en']:
                return False, f"Idioma não permitido: {idioma}."
        except:
            return False, "Não foi possível detectar o idioma."

        # Verifica se usa apenas caracteres latinos
        for char in texto:
            if char.isalpha():
                nome = unicodedata.name(char, '')
                if 'LATIN' not in nome:
                    return False, f"Caractere não latino detectado: {char}"
        
        # Verifica o tamanho
        if not (min_len <= len(texto) <= max_len):
            return False, f"Tamanho do texto fora dos limites ({min_len}-{max_len})."

        return True, "OK"

    # Verificar pergunta e resposta
    ok_pergunta, motivo_pergunta = validar_texto(pergunta)
    ok_resposta, motivo_resposta = validar_texto(resposta)

    return {
        "pergunta_valida": ok_pergunta,
        "motivo_pergunta": motivo_pergunta,
        "resposta_valida": ok_resposta,
        "motivo_resposta": motivo_resposta
    }

# Exemplo de uso:
resultado = verificar_mensagem("Qual é a capital da França?", "A capital da França é Paris.")
print(resultado)

